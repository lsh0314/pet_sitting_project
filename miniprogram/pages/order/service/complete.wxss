/* 页面容器 */
.container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background-color: #f5f7fa;
  padding-bottom: 30rpx;
}

/* 导航栏 */
.nav-bar {
  display: flex;
  align-items: center;
  padding: 30rpx;
  padding-top: 80rpx; /* 增加顶部安全区域，防止被手机刘海挡住 */
  background-color: #ffffff;
  position: relative;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.back-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  font-size: 40rpx;
  color: #333;
}

.page-title {
  flex: 1;
  text-align: center;
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  margin-right: 60rpx; /* 为了标题居中 */
}

/* 订单信息卡片 */
.order-info-card {
  margin: 30rpx;
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.order-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
  padding-bottom: 16rpx;
}

.order-detail {
  display: flex;
  flex-direction: column;
}

.info-item {
  display: flex;
  margin-bottom: 20rpx;
  align-items: center;
}

.label {
  width: 160rpx;
  color: #666;
  font-size: 28rpx;
}

.value {
  flex: 1;
  color: #333;
  font-size: 28rpx;
  font-weight: 500;
}

/* 上传类型切换 */
.upload-type-tabs {
  display: flex;
  margin: 30rpx 30rpx 0;
  background-color: #ffffff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #666;
  background-color: #f8f9fa;
  position: relative;
  transition: all 0.3s;
}

.tab.active {
  color: #333;
  font-weight: 600;
  background-color: #ffffff;
}

.tab.active::after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 25%;
  width: 50%;
  height: 6rpx;
  background-color: #fde74c;
  border-radius: 3rpx;
}

/* 拍照区域 */
.photo-area {
  margin: 30rpx;
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.photo-tip {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 30rpx;
  text-align: center;
  line-height: 1.5;
}

.camera-placeholder {
  width: 100%;
  height: 400rpx;
  background-color: #f8f9fa;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #ddd;
  transition: all 0.3s;
}

.camera-placeholder:active {
  background-color: #f0f0f0;
}

.camera-icon {
  font-size: 90rpx;
  margin-bottom: 20rpx;
  color: #8c9eff;
}

.camera-text {
  font-size: 30rpx;
  color: #666;
  font-weight: 500;
}

.photo-preview {
  width: 100%;
  position: relative;
}

.preview-image {
  width: 100%;
  height: 400rpx;
  border-radius: 16rpx;
  display: block;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.photo-actions {
  margin-top: 24rpx;
  display: flex;
  justify-content: center;
}

.btn-retake {
  font-size: 28rpx;
  padding: 12rpx 36rpx;
  background-color: #fde74c;
  color: #333;
  border-radius: 30rpx;
  border: none;
  box-shadow: 0 2rpx 8rpx rgba(253, 231, 76, 0.2);
}

/* 视频区域 */
.video-area {
  margin: 30rpx;
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.video-tip {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 30rpx;
  text-align: center;
  line-height: 1.5;
}

.video-preview {
  width: 100%;
  position: relative;
}

.preview-video {
  width: 100%;
  height: 400rpx;
  border-radius: 16rpx;
  display: block;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.video-actions {
  margin-top: 24rpx;
  display: flex;
  justify-content: center;
}

/* 位置验证区域 */
.location-area {
  margin: 30rpx;
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx;
  display: flex;
  flex-direction: column;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.location-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
  padding-bottom: 16rpx;
}

.location-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.location-status {
  font-size: 28rpx;
  color: #ff9800;
  font-weight: 500;
}

.location-status.verified {
  color: #4caf50;
}

.location-info {
  background-color: #f8f9fa;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.location-address {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 16rpx;
}

.location-distance {
  font-size: 28rpx;
  color: #666;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.distance-tag {
  font-size: 24rpx;
  padding: 6rpx 12rpx;
  border-radius: 12rpx;
}

.distance-tag.good {
  background-color: rgba(76, 175, 80, 0.1);
  color: #4caf50;
}

.distance-tag.bad {
  background-color: rgba(255, 152, 0, 0.1);
  color: #ff9800;
}

.btn-verify-location {
  background-color: #fde74c;
  color: #333;
  font-size: 30rpx;
  font-weight: 500;
  padding: 18rpx 0;
  border-radius: 40rpx;
  border: none;
  margin-top: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(253, 231, 76, 0.3);
  transition: all 0.3s;
}

.btn-verify-location:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 6rpx rgba(253, 231, 76, 0.3);
}

.btn-verify-location.btn-disabled {
  background-color: #f0f0f0;
  color: #999;
  box-shadow: none;
}

/* 底部操作区 */
.footer-action {
  margin: 30rpx;
  padding: 20rpx 0;
}

.btn-primary {
  width: 100%;
  background-color: #fde74c;
  color: #333;
  font-size: 32rpx;
  font-weight: 600;
  padding: 24rpx 0;
  border-radius: 40rpx;
  border: none;
  box-shadow: 0 4rpx 12rpx rgba(253, 231, 76, 0.3);
  transition: all 0.3s;
}

.btn-primary:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 6rpx rgba(253, 231, 76, 0.3);
}

.btn-primary.btn-disabled {
  background-color: #f0f0f0;
  color: #999;
  box-shadow: none;
}

/* 加载中状态 */
.loading-container {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(255, 255, 255, 0.9);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.loading-icon {
  width: 80rpx;
  height: 80rpx;
  border: 4rpx solid #fde74c;
  border-top-color: transparent;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  0% {
    transform: rotate(0deg);
  }
  100% {
    transform: rotate(360deg);
  }
}

/* 错误状态 */
.error-container {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: #fff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.error-container text {
  margin: 30rpx 0;
  font-size: 32rpx;
  color: #666;
}

.btn-retry {
  background-color: #fde74c;
  color: #333;
  font-size: 30rpx;
  padding: 16rpx 60rpx;
  border-radius: 40rpx;
  border: none;
  box-shadow: 0 4rpx 12rpx rgba(253, 231, 76, 0.3);
}
