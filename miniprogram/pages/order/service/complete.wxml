<view class="container">
  <!-- 顶部导航栏 -->
  <view class="nav-bar">
    <view class="back-btn" bindtap="goBack">
      <text class="back-icon">←</text>
    </view>
    <view class="page-title">服务完成打卡</view>
  </view>

  <!-- 订单信息 -->
  <view class="order-info-card" wx:if="{{!loading && orderInfo}}">
    <view class="order-title">订单信息</view>
    <view class="order-detail">
      <view class="info-item">
        <text class="label">宠物名称:</text>
        <text class="value">{{orderInfo.pet.name}}</text>
      </view>
      <view class="info-item">
        <text class="label">服务类型:</text>
        <text class="value">
          <text wx:if="{{orderInfo.serviceType === 'walk'}}">🐕 遛狗</text>
          <text wx:elif="{{orderInfo.serviceType === 'feed'}}">🍽️ 喂食</text>
          <text wx:else>🏠 寄养</text>
        </text>
      </view>
      <view class="info-item">
        <text class="label">服务地址:</text>
        <text class="value">📍 {{orderInfo.address}}</text>
      </view>
    </view>
  </view>

  <!-- 上传类型切换 -->
  <view class="upload-type-tabs">
    <view class="tab {{uploadType === 'photo' ? 'active' : ''}}" bindtap="switchUploadType" data-type="photo">
      📷 拍照打卡
    </view>
    <view class="tab {{uploadType === 'video' ? 'active' : ''}}" bindtap="switchUploadType" data-type="video">
      🎥 视频打卡
    </view>
  </view>

  <!-- 拍照区域 -->
  <view class="photo-area" wx:if="{{uploadType === 'photo'}}">
    <view class="photo-tip">📸 请拍摄一张服务完成的照片作为服务结束的凭证</view>
    
    <!-- 未拍照状态 -->
    <view class="camera-placeholder" wx:if="{{!photoTaken}}" bindtap="takePhoto">
      <view class="camera-icon">📷</view>
      <view class="camera-text">点击拍照</view>
    </view>
    
    <!-- 已拍照状态 -->
    <view class="photo-preview" wx:if="{{photoTaken}}">
      <image class="preview-image" src="{{photoPath}}" mode="aspectFill"></image>
      <view class="photo-actions">
        <button class="btn-retake" bindtap="retakePhoto">重新拍照</button>
      </view>
    </view>
  </view>

  <!-- 视频区域 -->
  <view class="video-area" wx:if="{{uploadType === 'video'}}">
    <view class="video-tip">🎥 请拍摄一段服务完成的视频作为服务结束的凭证 (最长30秒)</view>
    
    <!-- 未拍视频状态 -->
    <view class="camera-placeholder" wx:if="{{!videoTaken}}" bindtap="takeVideo">
      <view class="camera-icon">🎥</view>
      <view class="camera-text">点击拍视频</view>
    </view>
    
    <!-- 已拍视频状态 -->
    <view class="video-preview" wx:if="{{videoTaken}}">
      <video class="preview-video" src="{{videoPath}}" controls></video>
      <view class="video-actions">
        <button class="btn-retake" bindtap="retakeVideo">重新拍摄</button>
      </view>
    </view>
  </view>

  <!-- 位置验证区域 -->
  <view class="location-area">
    <view class="location-header">
      <view class="location-title">位置验证</view>
      <view class="location-status {{locationVerified ? 'verified' : ''}}">
        {{locationVerified ? '✅ 已验证' : '⏳ 未验证'}}
      </view>
    </view>
    
    <view class="location-info" wx:if="{{currentLocation}}">
      <view class="location-address">📍 {{currentLocation.address || '获取地址中...'}}</view>
      <view class="location-distance" wx:if="{{distance !== null}}">
        距服务地点: {{distance}}米
        <text class="distance-tag {{distance < 500 ? 'good' : 'bad'}}">
          {{distance < 500 ? '✅ 在范围内' : '⚠️ 距离较远'}}
        </text>
      </view>
    </view>
    
    <button 
      class="btn-verify-location {{locationVerified ? 'btn-disabled' : ''}}" 
      disabled="{{locationVerified}}"
      bindtap="verifyLocation"
    >
      {{locationVerified ? '已完成位置验证' : '确认位置'}}
    </button>
  </view>

  <!-- 底部操作区 -->
  <view class="footer-action">
    <button 
      class="btn-primary {{((!photoTaken && !videoTaken) || !locationVerified || uploading) ? 'btn-disabled' : ''}}" 
      disabled="{{(!photoTaken && !videoTaken) || !locationVerified || uploading}}"
      bindtap="completeService"
    >
      <block wx:if="{{uploading}}">⏳ 处理中...</block>
      <block wx:else>✅ 确认完成服务</block>
    </button>
  </view>

  <!-- 加载中状态 -->
  <view class="loading-container" wx:if="{{loading}}">
    <view class="loading-icon"></view>
    <text>正在加载...</text>
  </view>
  
  <!-- 错误状态 -->
  <view class="error-container" wx:if="{{error}}">
    <icon type="warn" size="64"></icon>
    <text>加载失败，请重试</text>
    <button class="btn-retry" bindtap="getOrderDetail">重新加载</button>
  </view>
</view> 