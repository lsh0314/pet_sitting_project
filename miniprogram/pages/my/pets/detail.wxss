/* pages/my/pets/detail.wxss */
.container {
  padding: 0;
  background-color: #f8f8f8;
  min-height: 100vh;
}

.loading-container,
.error-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.loading-image {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 20rpx;
}

.loading {
  color: #999;
  font-size: 28rpx;
}

.error-message {
  color: #e64340;
  font-size: 28rpx;
  margin: 30rpx 0;
  text-align: center;
}

.retry-btn {
  background-color: #ffd100;
  color: #333;
  font-size: 28rpx;
  padding: 10rpx 30rpx;
  border-radius: 30rpx;
  box-shadow: 0 4rpx 8rpx rgba(255, 209, 0, 0.3);
}

/* 导航栏 */
.nav-bar {
  position: sticky;
  top: 0;
  left: 0;
  right: 0;
  height: 90rpx;
  background-color: #fff;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 30rpx;
  border-bottom: 1rpx solid #eee;
  z-index: 100;
}

.back-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  font-size: 40rpx;
  color: #333;
}

.placeholder {
  width: 60rpx;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
  position: relative;
}

.nav-title::after {
  content: "";
  position: absolute;
  bottom: -6rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 6rpx;
  background-color: #ffd100;
  border-radius: 3rpx;
}

.pet-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0;
  background-color: #fff;
  border-radius: 0 0 24rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
  position: relative;
  overflow: hidden;
}

.pet-header::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 60rpx;
  background-color: #ffd100;
  opacity: 0.1;
}

.pet-photo-container {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 30rpx;
}

.pet-photo {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  border: 4rpx solid #fff;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  background-color: #f0f0f0;
}

.edit-photo-hint {
  position: absolute;
  bottom: 0;
  right: 0;
  background-color: #ffd100;
  color: #333;
  border-radius: 50%;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(255, 209, 0, 0.3);
}

.edit-photo-hint .icon {
  font-size: 32rpx;
}

.pet-name {
  font-size: 40rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 10rpx;
}

.pet-breed {
  font-size: 28rpx;
  color: #999;
  padding: 4rpx 20rpx;
  background-color: #fff9e0;
  border-radius: 20rpx;
}

.action-bar {
  display: flex;
  justify-content: space-between;
  padding: 20rpx;
  margin: 0 20rpx 20rpx;
  background-color: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.action-btn {
  flex: 1;
  margin: 0 10rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 500;
  transition: all 0.3s ease;
}

.btn-icon {
  margin-right: 10rpx;
  font-size: 32rpx;
}

.action-btn.edit {
  background-color: #fff9e0;
  color: #ffd100;
  border: 1px solid #ffd100;
}

.action-btn.edit:active {
  transform: scale(0.98);
}

.action-btn.cancel {
  background-color: #f8f8f8;
  color: #999;
  border: 1px solid #ddd;
}

.action-btn.delete {
  background-color: #fff5f5;
  color: #e64340;
  border: 1px solid #e64340;
}

.action-btn.delete:active {
  transform: scale(0.98);
}

.action-btn.save {
  background-color: #ffd100;
  color: #333;
  box-shadow: 0 4rpx 8rpx rgba(255, 209, 0, 0.3);
}

.action-btn.save:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 4rpx rgba(255, 209, 0, 0.3);
}

.action-btn[disabled] {
  background-color: #ffe97f;
  color: rgba(51, 51, 51, 0.6);
  box-shadow: none;
}

.form-container {
  margin: 0 20rpx;
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.form-section {
  margin-bottom: 40rpx;
  padding-bottom: 30rpx;
  border-bottom: 1px solid #f0f0f0;
}

.form-section:last-child {
  border-bottom: none;
  margin-bottom: 0;
  padding-bottom: 0;
}

.section-title {
  display: flex;
  align-items: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 30rpx;
  position: relative;
  padding-left: 20rpx;
}

.section-title::before {
  content: "";
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 8rpx;
  height: 32rpx;
  background-color: #ffd100;
  border-radius: 4rpx;
}

.section-icon {
  margin-right: 10rpx;
  font-size: 36rpx;
}

.form-item {
  margin-bottom: 30rpx;
  position: relative;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
}

.label-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.required::after {
  content: "*";
  color: #e64340;
  margin-left: 6rpx;
}

.form-value {
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
  background-color: #fafafa;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
}

.gender-value {
  display: flex;
  align-items: center;
}

.gender-icon {
  font-size: 32rpx;
  margin-right: 8rpx;
  color: #ffd100;
}

.status-tag {
  display: inline-block;
  padding: 6rpx 20rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
}

.status-yes {
  background-color: #fff9e0;
  color: #ffd100;
}

.status-no {
  background-color: #ffebee;
  color: #e64340;
}

.empty-vaccine {
  color: #999;
  font-style: italic;
}

.form-input {
  width: 100%;
  height: 80rpx;
  background-color: #f8f8f8;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  border: 1px solid #eee;
  transition: border-color 0.3s ease;
}

.form-input:focus {
  border-color: #ffd100;
}

.form-textarea {
  width: 100%;
  height: 160rpx;
  background-color: #f8f8f8;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  border: 1px solid #eee;
  transition: border-color 0.3s ease;
}

.form-textarea:focus {
  border-color: #ffd100;
}

.radio-group {
  display: flex;
  flex-direction: row;
}

.radio {
  margin-right: 40rpx;
  font-size: 28rpx;
  color: #333;
  display: flex;
  align-items: center;
}

.gender-text {
  margin-left: 8rpx;
}

.tags-container {
  display: flex;
  flex-wrap: wrap;
}

.tag {
  padding: 10rpx 20rpx;
  background-color: #f8f8f8;
  border-radius: 30rpx;
  margin-right: 20rpx;
  margin-bottom: 20rpx;
  font-size: 24rpx;
  color: #666;
  transition: all 0.3s ease;
}

.tag.selected {
  background-color: #ffd100 !important;
  color: #333 !important;
  transform: scale(1.05);
  box-shadow: 0 2rpx 8rpx rgba(255, 209, 0, 0.3);
  border: 1rpx solid #ffd100 !important;
}

.vaccine-photos {
  display: flex;
  flex-wrap: wrap;
}

.vaccine-photo-item {
  width: 150rpx;
  height: 150rpx;
  margin-right: 20rpx;
  margin-bottom: 20rpx;
  position: relative;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.vaccine-photo {
  width: 100%;
  height: 100%;
}

.delete-icon {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  width: 40rpx;
  height: 40rpx;
  background-color: rgba(230, 67, 64, 0.9);
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
}

.vaccine-upload-btn {
  width: 150rpx;
  height: 150rpx;
  background-color: #fff9e0;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px dashed #ffd100;
}

.upload-icon {
  font-size: 60rpx;
  color: #ffd100;
  line-height: 1;
}

.footer-space {
  height: 80rpx;
}
