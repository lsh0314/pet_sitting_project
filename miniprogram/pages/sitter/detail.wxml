<view class="container">
  <!-- 顶部导航栏 -->
  <view class="nav-bar">
    <view class="back-btn" bindtap="goBack">
      <text class="back-icon">←</text>
    </view>
    <view class="page-title">帮溜员详情</view>
  </view>

  <!-- 帮溜员信息 -->
  <scroll-view scroll-y class="scroll-container" wx:if="{{!loading && sitterInfo}}">
    <view class="sitter-info-container">
      <view class="sitter-header">
        <image class="sitter-avatar" src="{{sitterInfo.avatar || '/static/images/default-avatar.png'}}"></image>
        <view class="sitter-basic">
          <view class="sitter-name">{{sitterInfo.nickname || '帮溜员'}}</view>
          <view class="sitter-rating">
            <text class="icon-star">★</text>
            <text>{{sitterInfo.rating || '5.0'}}</text>
            <text class="sitter-orders">已完成 {{sitterInfo.totalServices || 0}} 单</text>
          </view>
        </view>
      </view>
      
      <view class="sitter-content">
        <!-- 个人简介 -->
        <view class="section">
          <view class="section-title">个人简介</view>
          <view class="section-content">
            <text class="bio">{{sitterInfo.bio || '这位帮溜员很懒，还没有填写简介~'}}</text>
          </view>
        </view>
        
        <!-- 历史评价 -->
        <view class="section">
          <view class="section-title">历史评价</view>
          <view class="section-content">
            <block wx:if="{{latestReview}}">
              <!-- 最新一条评价 -->
              <view class="review-item">
                <view class="review-header">
                  <image class="reviewer-avatar" src="{{latestReview.reviewerAvatar || '/static/images/default-avatar.png'}}"></image>
                  <view class="reviewer-info">
                    <view class="reviewer-name">{{latestReview.reviewerName || '匿名用户'}}</view>
                    <view class="review-date">{{latestReview.createdAtFormatted}}</view>
                  </view>
                  <view class="review-rating">
                    <text class="icon-star">★</text>
                    <text>{{latestReview.rating}}</text>
                  </view>
                </view>
                <view class="review-content">{{latestReview.comment || '该用户未留下评价内容'}}</view>
                <view class="review-tags" wx:if="{{latestReview.tags && latestReview.tags.length > 0}}">
                  <text class="review-tag" wx:for="{{latestReview.tags}}" wx:key="*this">{{item}}</text>
                </view>
              </view>
              
              <!-- 查看更多评价按钮 -->
              <view class="view-more" bindtap="toggleReviews" wx:if="{{reviewsTotal > 1}}">
                <text>{{showAllReviews ? '收起' : '查看更多评价'}}</text>
                <text class="arrow">{{showAllReviews ? '↑' : '↓'}}</text>
              </view>
              
              <!-- 更多评价列表 -->
              <view class="more-reviews" wx:if="{{showAllReviews && reviews.length > 1}}">
                <view class="review-item" wx:for="{{reviews}}" wx:key="id" wx:if="{{index > 0}}">
                  <view class="review-header">
                    <image class="reviewer-avatar" src="{{item.reviewerAvatar || '/static/images/default-avatar.png'}}"></image>
                    <view class="reviewer-info">
                      <view class="reviewer-name">{{item.reviewerName || '匿名用户'}}</view>
                      <view class="review-date">{{item.createdAtFormatted}}</view>
                    </view>
                    <view class="review-rating">
                      <text class="icon-star">★</text>
                      <text>{{item.rating}}</text>
                    </view>
                  </view>
                  <view class="review-content">{{item.comment || '该用户未留下评价内容'}}</view>
                  <view class="review-tags" wx:if="{{item.tags && item.tags.length > 0}}">
                    <text class="review-tag" wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this">{{tag}}</text>
                  </view>
                </view>
                
                <!-- 加载更多按钮 -->
                <view class="load-more" bindtap="loadMoreReviews" wx:if="{{reviews.length < reviewsTotal}}">
                  <text>{{reviewsLoading ? '加载中...' : '加载更多'}}</text>
                </view>
              </view>
            </block>
            <view wx:else class="no-reviews">暂无评价</view>
          </view>
        </view>
        
        <!-- 服务区域 -->
        <view class="section">
          <view class="section-title">服务区域</view>
          <view class="section-content">
            <text>{{sitterInfo.serviceArea || '暂无服务区域信息'}}</text>
          </view>
        </view>
        
        <!-- 服务项目和价格 -->
        <view class="section">
          <view class="section-title">服务项目</view>
          <view class="section-content">
            <view class="service-list">
              <block wx:if="{{sitterInfo.services && sitterInfo.services.length > 0}}">
                <view class="service-item" wx:for="{{sitterInfo.services}}" wx:key="type">
                  <view class="service-name">
                    <text wx:if="{{item.type === 'walk'}}">🐕 遛狗</text>
                    <text wx:elif="{{item.type === 'feed'}}">🐱 喂食</text>
                    <text wx:else>🏠 寄养</text>
                  </view>
                  <view class="service-price">¥{{item.price}}/次</view>
                </view>
              </block>
              <view wx:else class="no-service">暂无服务项目</view>
            </view>
          </view>
        </view>
        
        <!-- 可预约日期 -->
        <view class="section" wx:if="{{sitterInfo.availableDates && sitterInfo.availableDates.length > 0}}">
          <view class="section-title">可预约日期</view>
          <view class="section-content">
            <view class="date-list">
              <text class="date-tag" wx:for="{{sitterInfo.availableDates}}" wx:key="*this">{{item}}</text>
            </view>
          </view>
        </view>
      </view>
      
      <!-- 底部占位，确保内容不被底部操作栏遮挡 -->
      <view class="footer-placeholder"></view>
    </view>
  </scroll-view>
  
  <!-- 加载中状态 -->
  <view class="loading-container" wx:if="{{loading}}">
    <view class="loading-icon"></view>
    <text>正在加载...</text>
  </view>
  
  <!-- 错误状态 -->
  <view class="error-container" wx:if="{{error}}">
    <icon type="warn" size="64"></icon>
    <text>加载失败，请重试</text>
    <button class="btn-retry" bindtap="onTapRetry">重新加载</button>
  </view>
  
  <!-- 底部操作栏 -->
  <view class="footer-action" wx:if="{{!loading && sitterInfo}}">
    <button class="btn-primary btn-order" bindtap="onTapOrder">向TA下单</button>
  </view>
</view> 